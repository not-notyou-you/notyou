# ===== SUPABASE =====
# Newer Supabase projects only show "Publishable key" / "Secret key" in the
# dashboard (Settings > API Keys) instead of the old anon/service_role names.
# The publishable key is the client-safe one — same privileges as the old
# anon key, safe to ship in the frontend bundle.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ===== CLOUDINARY (unsigned upload preset, safe for client-side) =====
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=portfolio-uploads

# Admin users are created directly in Supabase Auth (dashboard or CLI) —
# there is no separate admin email/password baked into the frontend.
